NODE_ENV=production
PORT=4100
# Same persistent database used by PeerPrep. Use a DB user with read access to
# aiinterviews/resumes and write access only to aiinterviewsessions if possible.
MONGODB_URI=mongodb://app_user:ENCODED_PASSWORD@127.0.0.1:27017/app?authSource=app&directConnection=true
# Same 32+ character secret configured on PeerPrep's main API.
INTERVIEW_SERVICE_SECRET=replace-with-a-long-random-secret
# Provider-neutral configuration. AI_PROVIDER may be openai or gemini.
# AI_API_KEY is always server-side and must never be exposed to the browser.
AI_PROVIDER=gemini
AI_API_KEY=your-server-side-key
AI_INTERVIEW_MODEL=gemini-3.8-flash
AI_INTERVIEW_TRANSCRIBE_MODEL=gemini-3.8-flash
AI_INTERVIEW_TTS_MODEL=gemini-3.8-flash-tts
AI_INTERVIEW_VOICE=Kore

# OpenAI example:
# AI_PROVIDER=openai
# AI_INTERVIEW_MODEL=gpt-4o-mini
# AI_INTERVIEW_TRANSCRIBE_MODEL=gpt-transcribe
# AI_INTERVIEW_TTS_MODEL=gpt-4o-mini-tts
# AI_INTERVIEW_VOICE=coral
